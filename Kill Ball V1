local modoAtaqueAtivo = false

local function desativarModoAtaque()
    modoAtaqueAtivo = false
    actionButton.Text = "FLING\nBALL"
    actionButton.BackgroundTransparency = 0
    actionButton.TextTransparency = 0
end

actionButton.MouseButton1Click:Connect(function()
    -- Se a mochila estiver aberta, ignora o clique de ataque (foco no Drag & Drop)
    if _G.ScriptAdapter and _G.ScriptAdapter.MainPanel and _G.ScriptAdapter.MainPanel.Visible then
        return
    end

    -- Alterna o modo de preparo de ataque na tela principal
    modoAtaqueAtivo = not modoAtaqueAtivo
    
    if modoAtaqueAtivo then
        actionButton.BackgroundTransparency = 0.45
        actionButton.TextTransparency = 0.2
    else
        desativarModoAtaque()
    end
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed or not modoAtaqueAtivo then return end

    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local pos = input.Position
        local unitRay = camera:ScreenPointToRay(pos.X, pos.Y)
        
        local raycastParams = RaycastParams.new()
        raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
        raycastParams.FilterDescendantsInstances = {character}

        local raycastResult = Workspace:Raycast(unitRay.Origin, unitRay.Direction * 50000, raycastParams)

        if raycastResult and raycastResult.Instance then
            local hitPart = raycastResult.Instance
            local model = hitPart:FindFirstAncestorOfClass("Model")

            if model and model:FindFirstChild("Humanoid") then
                local tPlayer = Players:GetPlayerFromCharacter(model)

                if tPlayer and tPlayer ~= lp then
                    actionButton.Text = "LANÇAR\nBALL"
                    executarAtaqueLimitado(tPlayer)
                    
                    task.delay(0.5, function()
                        desativarModoAtaque()
                    end)
                end
            end
        end
    end
end)

-- REGISTRO DA TOOL NO ADAPTADOR
_G.ScriptAdapter = _G.ScriptAdapter or {}
_G.ScriptAdapter.Queue = _G.ScriptAdapter.Queue or {}

local toolData = {
    Id = "FlingBall_Tool",
    ButtonUI = actionButton,
    OnEquip = function()
        modoAtaqueAtivo = true
    end,
    OnUnequip = function()
        desativarModoAtaque()
    end
}

if _G.ScriptAdapter and _G.ScriptAdapter.RegisterTool then
    _G.ScriptAdapter:RegisterTool(toolData)
else
    table.insert(_G.ScriptAdapter.Queue, toolData)
end